        subgraph SECRETS_LAYER["Secrets Layer"]
            ASM["AWS Secrets Manager\narn:aws:secretsmanager:eu-west-2:123:secret:citizen/frontend/db-pass\nEncryption: AWS KMS (FIPS 140-2 L3)\nRotation: 30 days (auto)"]
            KMS["AWS KMS Key\narn:aws:kms:eu-west-2:123:key/abc-123\nUsage: Secrets Manager encryption\nAccess: ESO IRSA role only"]
        end

        subgraph CI_LAYER["CI/CD Pipeline (GitLab Self-Managed)"]
            GITLAB_CI["GitLab CI Pipeline\nStages: lint → policy → build → scan → sign → deploy"]
