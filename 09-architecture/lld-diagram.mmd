            TRIVY_CI["Trivy 0.55\nImage CVE Scan\nCritical → hard-fail\nHigh with fix → 14-day SLA"]
            COSIGN_SIGN["Cosign 2.4\nSign with: awskms:///arn:aws:kms:...\nAttest: SBOM (CycloneDX)\nAttest: Vulnerability scan\nAttest: SLSA provenance"]
        end

        subgraph MONITORING["Monitoring & Detection"]
            CW_LOGS["CloudWatch Logs\nRetention: 90 days hot, 1 year cold\nLog Groups:\n  /aws/eks/citizen-cluster/cluster (audit)\n  /aws/falco/citizen-cluster (runtime)\n  /aws/ec2/node-metrics (node)"]
            PAGERDUTY["PagerDuty\n(P1: container escape, RBAC mutation)"]
            SLACK_SEC["Slack #security-alerts\n(P2: drift, shell spawn)"]
        end
    end

    %% Data flows
    CITIZEN -->|"HTTPS :443"| ALB
    ALB -->|"TLS → HTTP\n(X-Forwarded-For)"| FE_CONTAINER

    FE_CONTAINER -->|"gRPC :8080\n(Cilium mTLS)"| BE_CONTAINER
    BE_CONTAINER -->|"PostgreSQL TLS\n:5432 (VPC private)"| RDS["RDS PostgreSQL\nEncryption: KMS\nBackup: daily snapshot\nMulti-AZ: yes"]

    COTS_CONTAINER -->|"HTTPS :8443\n(restricted ingress)"| BE_CONTAINER
    COTS_CONTAINER -.->|"License validation\n(via egress proxy)"| VENDOR_EXT["Vendor License Server\n(external)"]

    ESO_SYNC["ESO Controller\n(namespace: external-secrets)"] -->|"polls every 1h"| ASM
    ASM -.->|"encrypted by"| KMS
    FE_SECRET_VOLUME -.->|"ESO syncs → K8s Secret\n→ projected volume"| ASM
    BE_SECRET_VOLUME -.->|"ESO syncs → K8s Secret\n→ projected volume"| ASM
    COTS_SECRET_VOLUME -.->|"ESO syncs → K8s Secret\n→ projected volume"| ASM

    FALCO_DAEMON -->|"P1 alerts"| PAGERDUTY
    FALCO_DAEMON -->|"P2 alerts"| SLACK_SEC
    FALCO_DAEMON -->|"all events"| CW_LOGS
    API_SERVER -->|"audit events"| CW_LOGS

    GITLAB_CI -->|"triggers build"| TRIVY_CI
    GITLAB_CI -->|"policy gate"| CONFTEST_CI
    GITLAB_CI -->|"sign image"| COSIGN_SIGN
    COSIGN_SIGN -.->|"verify at admission"| KYVERNO_CP
    CONFTEST_CI -.->|"blocks merge\nif Critical/High"| GITLAB_CI

    OIDC -.->|"IRSA token exchange"| ESO_SYNC

