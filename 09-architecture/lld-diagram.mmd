                    end

                    subgraph NODE_SECURITY["Node-Level Security"]
                        FALCO_DAEMON["Falco 0.38 DaemonSet\nDriver: eBPF (privileged: false)\nRules: P1 Critical / P2 High / P3 Medium"]
