        subgraph PRIVATE_SUBNET["Private Subnets (3 AZs)"]
            subgraph EKS_NODE_GROUP["EKS Managed Node Group\nami-0abcdef1234567890\n(amazon-linux-2-x86_64)"]
                subgraph NODE_1["Node: ip-10-0-1-42\nKernel: 5.10 (eBPF)"]
                    subgraph CILIUM_NODE["Cilium eBPF Data Plane"]
                        subgraph FE_NAMESPACE["Namespace: citizen-frontend\nPSA: Restricted"]
                            subgraph FE_POD["Pod: frontend-deploy-7f8c9b\nSA: frontend-sa\nIRSA: arn:aws:iam::123:role/citizen-frontend-eso"]
                                FE_CONTAINER["Container: frontend\nimage: registry/frontend@sha256:abc...\nsecurityContext:\n  runAsNonRoot: true\n  runAsUser: 1000\n  readOnlyRootFilesystem: true\n  allowPrivilegeEscalation: false\n  capabilities.drop: [ALL]\n  seccompProfile: RuntimeDefault"]
                                FE_SECRET_VOLUME["Volume: vault-key\nType: projected (from K8s Secret)\n  → mounted at /etc/secrets"]
                                FE_TMP["Volume: tmp\nType: emptyDir"]
                            end
                            FE_NP["CiliumNetworkPolicy:\n  ingress: ALB SG → TCP/443\n  egress: → citizen-backend TCP/8080\n          → kube-dns UDP/53\n          → egress-proxy TCP/443"]
                        end

                        subgraph BE_NAMESPACE["Namespace: citizen-backend\nPSA: Restricted"]
                            subgraph BE_POD["Pod: backend-deploy-3a2d1e\nSA: backend-sa\nIRSA: arn:aws:iam::123:role/citizen-backend-eso"]
                                BE_CONTAINER["Container: backend\nimage: registry/backend@sha256:def...\nsecurityContext:\n  runAsNonRoot: true\n  runAsUser: 1000\n  readOnlyRootFilesystem: true\n  allowPrivilegeEscalation: false\n  capabilities.drop: [ALL]\n  seccompProfile: RuntimeDefault"]
                                BE_SECRET_VOLUME["Volume: vault-key\nType: projected (from K8s Secret)"]
                            end
                            BE_NP["CiliumNetworkPolicy:\n  ingress: citizen-frontend → TCP/8080\n  egress: → RDS TCP/5432 (VPC CIDR)\n          → kube-dns UDP/53"]
                        end

                        subgraph COTS_NAMESPACE["Namespace: cots-vendor\nPSA: Restricted"]
                            subgraph COTS_POD["Pod: cots-deploy-9f4e2a\nSA: cots-vendor-sa\nIRSA: arn:aws:iam::123:role/cots-vendor-eso"]
                                COTS_CONTAINER["Container: cots-vendor\nimage: registry/cots@sha256:ghi...\n⚠️ Runs as root (vendor requirement)\n⚠️ Known CVEs (accepted risk)"]
