        <mxCell id="cots_pod" value="Pod: cots-deploy-9f4e2a&#xa;SA: cots-vendor-sa&#xa;IRSA: cots-vendor-eso&#xa;⚠ Runs as root (vendor requirement)&#xa;⚠ Known CVEs (accepted risk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=11;fontStyle=1;" vertex="1" parent="ns_cots">
          <mxGeometry x="30" y="40" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cots_controls" value="4 Compensating Controls:&#xa;1. CiliumNetworkPolicy — isolated namespace&#xa;   (ingress: backend→TCP/8443 only)&#xa;   (egress: egress-proxy→TCP/443 only)&#xa;2. Falco — COTS-specific rules:&#xa;   P1: shell spawn, /etc/shadow read&#xa;   P2: unexpected network connection&#xa;3. Kyverno — no RBAC modification&#xa;   image by digest only in this NS&#xa;4. Weekly Trivy scan + auto-ticket&#xa;   on new Critical CVE" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;size=15;" vertex="1" parent="ns_cots">
          <mxGeometry x="30" y="150" width="290" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="cots_np" value="CiliumNetworkPolicy:&#xa;  Ingress: citizen-backend → TCP/8443 ONLY&#xa;  Egress: → egress-proxy TCP/443 ONLY&#xa;           → kube-dns UDP/53&#xa;  ALL OTHER EGRESS: DENIED" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;size=15;" vertex="1" parent="ns_cots">
          <mxGeometry x="340" y="40" width="250" height="100" as="geometry"/>
