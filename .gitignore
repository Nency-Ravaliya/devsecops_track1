# Local environment and secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Kubernetes local config files
.kube/
.kubeconfig
kubeconfig*

# Local tooling / caches
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.temp

# Build and generated artifacts — runtime outputs are gitignored;
# but the evidence/ and example artefacts checked in for review are kept.
artifacts/*.tar
artifacts/*.tgz
coverage/
build/
dist/
node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Docker/local image artifacts
*.tar
*.tgz

# Office / presentation outputs
*.docx
*.pptx
*.pdf

# Optional: local demo output or generated reports (real runs only)
# Do NOT ignore tracked example/evidence JSON files
*.csv

# Keep repo policy files and evidence artefacts tracked
!platform-policies/**
!02-pipeline-supply-chain/*.yml
!02-pipeline-supply-chain/*.yaml
!02-pipeline-supply-chain/evidence/**
!08-compliance/evidence/**
!scripts/install_kind.sh
